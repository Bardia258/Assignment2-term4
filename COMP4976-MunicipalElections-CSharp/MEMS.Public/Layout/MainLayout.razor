@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100">
    <NavMenu />

    <main class="container flex-grow-1 py-3">
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <ErrorAlert Message="Something went wrong while showing this page. Please try again."
                            OnRetry="Recover" />
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <footer class="border-top py-3 text-secondary small d-print-none">
        <div class="container">
            Your voting guide stays in this browser tab only and is never sent to our servers.
        </div>
    </footer>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    private void Recover() => errorBoundary?.Recover();
}
