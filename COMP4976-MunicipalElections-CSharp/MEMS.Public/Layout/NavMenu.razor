@* Top navigation. Tenant links appear only when a municipality is active (from the URL). *@
@implements IDisposable
@using MEMS.Public.Services.Tenancy
@inject TenantState TenantState

<nav class="navbar navbar-expand-md navbar-dark bg-primary d-print-none">
    <div class="container">
        <a class="navbar-brand" href="">Municipal Elections</a>

        <button class="navbar-toggler" type="button" aria-controls="main-nav"
                aria-expanded="@(!collapsed ? "true" : "false")" aria-label="Toggle navigation"
                @onclick="Toggle">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="main-nav" class="collapse navbar-collapse @(collapsed ? "" : "show")" @onclick="Collapse">
            @if (TenantState.Current is { } m)
            {
                <span class="navbar-text text-white fw-semibold me-md-3">@m.Name</span>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@m.Slug" Match="NavLinkMatch.All">Overview</NavLink>
                    </li>
                    @* Candidates and Voting guide links are added in Phases 2 and 4. *@
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Change municipality</NavLink>
                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Municipalities</NavLink>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@code {
    private bool collapsed = true;

    protected override void OnInitialized() => TenantState.Changed += OnTenantChanged;

    private void OnTenantChanged() => InvokeAsync(StateHasChanged);

    private void Toggle() => collapsed = !collapsed;

    private void Collapse() => collapsed = true;

    public void Dispose() => TenantState.Changed -= OnTenantChanged;
}
