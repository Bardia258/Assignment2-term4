@* Top navigation. Tenant links appear only when a municipality is active (from the URL).
   Collapses below the lg breakpoint: five tenant links plus the theme toggle wrap at tablet width. *@
@implements IDisposable
@using MEMS.Public.Services.Ballot
@using MEMS.Public.Services.Tenancy
@inject TenantState TenantState
@inject IBallotSessionService Ballot
@inject ILogger<NavMenu> Logger

<nav class="navbar navbar-expand-lg navbar-dark bg-primary d-print-none">
    <div class="container">
        <a class="navbar-brand" href="">Municipal Elections</a>

        <button class="navbar-toggler" type="button" aria-controls="main-nav"
                aria-expanded="@(!collapsed ? "true" : "false")" aria-label="Toggle navigation"
                @onclick="Toggle">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="main-nav" class="collapse navbar-collapse @(collapsed ? "" : "show")" @onclick="Collapse">
            @if (TenantState.Current is { } m)
            {
                <span class="navbar-text text-white fw-semibold me-lg-3">@m.Name</span>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link text-nowrap" href="@m.Slug" Match="NavLinkMatch.All">Overview</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-nowrap" href="@($"{m.Slug}/candidates")" Match="NavLinkMatch.Prefix">Candidates</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-nowrap" href="@($"{m.Slug}/guide")" Match="NavLinkMatch.Prefix">
                            My voting guide
                            @if (guideCount > 0)
                            {
                                <span class="badge rounded-pill text-bg-light ms-1">@guideCount<span class="visually-hidden"> selected</span></span>
                            }
                        </NavLink>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <NavLink class="nav-link text-nowrap" href="" Match="NavLinkMatch.All">Change municipality</NavLink>
                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link text-nowrap" href="" Match="NavLinkMatch.All">Municipalities</NavLink>
                    </li>
                </ul>
            }
            <div class="py-2 py-lg-0 ms-lg-3">
                <ThemeToggle />
            </div>
        </div>
    </div>
</nav>

@code {
    private bool collapsed = true;

    private int guideCount;

    protected override async Task OnInitializedAsync()
    {
        TenantState.Changed += OnTenantChanged;
        Ballot.Changed += OnBallotChanged;
        await RefreshCountAsync();
    }

    private async void OnTenantChanged() => await RefreshAndRenderAsync();

    private async void OnBallotChanged(string slug)
    {
        if (slug == TenantState.Current?.Slug) await RefreshAndRenderAsync();
    }

    private async Task RefreshAndRenderAsync()
    {
        try
        {
            await RefreshCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.GuideRefreshFailed(ex, "navbar count", TenantState.Current?.Slug ?? "");
        }
    }

    private async Task RefreshCountAsync() =>
        guideCount = TenantState.Current is { } m ? (await Ballot.GetAsync(m.Slug)).Count : 0;

    private void Toggle() => collapsed = !collapsed;

    private void Collapse() => collapsed = true;

    public void Dispose()
    {
        TenantState.Changed -= OnTenantChanged;
        Ballot.Changed -= OnBallotChanged;
    }
}
