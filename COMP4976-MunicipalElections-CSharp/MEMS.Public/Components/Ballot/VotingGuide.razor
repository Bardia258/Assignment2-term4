@*
    The voter's guide for one municipality. Ported from A1's Views/VotingGuide/Index.cshtml (header row,
    empty-state alert, green-bordered candidate cards with Remove), with these changes:
      - selections come from sessionStorage ("ballot:{slug}") instead of server session, one guide per municipality;
      - grouped by position in ballot order, with "x of N chosen" and links to fill open seats;
      - candidate details come from one tenant-scoped API call instead of one database query per saved id;
      - candidates who are no longer running are removed with a notice instead of silently kept;
      - Remove happens in place (A1 used a GET link that reloaded the page).
*@
@implements IDisposable
@using MEMS.Public.Services.Api
@using MEMS.Public.Services.Ballot
@inject VotingGuideLoader GuideLoader
@inject IBallotSessionService Ballot
@inject ILogger<VotingGuide> Logger

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 py-3">
    <div>
        <p class="text-uppercase text-secondary small mb-1">
            @Municipality.Name · Election day @Municipality.ElectionDate.ToString("MMM d, yyyy")
        </p>
        <h1 class="mb-0">My voting guide</h1>
    </div>
    @if (view is { ChosenCount: > 0 })
    {
        <div class="d-flex flex-wrap gap-2 d-print-none">
            @* A1's "Print My Guide" button, now opening the print view for this municipality only. *@
            <a class="btn btn-success" href="@($"{Municipality.Slug}/guide/print")">Print my guide</a>
            @if (!confirmingClear)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="() => confirmingClear = true">Clear guide</button>
            }
        </div>
    }
</div>

@if (confirmingClear && view is { ChosenCount: > 0 })
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
        <span class="flex-grow-1">Remove all @CountText(view.ChosenCount) from your @Municipality.Name guide?</span>
        <button type="button" class="btn btn-sm btn-danger" @onclick="ClearAsync">Yes, clear my guide</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmingClear = false">Cancel</button>
    </div>
}

<p class="text-secondary small mb-3">
    Your guide is saved only in this browser tab. It's cleared when you close the tab and is never sent to our servers.
</p>

@if (!Ballot.IsPersistent)
{
    <div class="alert alert-warning" role="alert">
        Your browser is blocking site storage, so this guide will be lost if you reload or leave the page.
    </div>
}

<p @ref="statusElement" tabindex="-1" class="guide-status mb-0" role="status" aria-live="polite">
    @if (statusMessage is not null)
    {
        <span class="d-block alert alert-success py-2">@statusMessage</span>
    }
</p>

@if (errorMessage is not null)
{
    <ErrorAlert Message="@errorMessage" OnRetry="ReloadAsync" />
}
else if (view is null)
{
    <LoadingSpinner Message="Loading your voting guide…" />
}
else
{
    @if (droppedCount > 0)
    {
        <div class="alert alert-info" role="status">
            @(droppedCount == 1 ? "1 candidate in your guide is" : $"{droppedCount} candidates in your guide are")
            no longer running and @(droppedCount == 1 ? "was" : "were") removed.
        </div>
    }

    @if (view.ChosenCount == 0)
    {
        <div class="alert alert-info">
            You haven't selected any candidates yet. Browse the <a href="@CandidatesHref()">candidate directory</a>
            to add them to your guide.
        </div>
    }
    else
    {
        <p class="mb-4">
            You've chosen <strong>@CountText(view.ChosenCount)</strong> for
            @(view.Sections.Count(s => s.Chosen.Count > 0)) of @view.Sections.Count positions.
        </p>
    }

    @foreach (var section in view.Sections)
    {
        var position = section.Position;
        var open = section.OpenSeats;

        <section class="mb-4" aria-labelledby="guide-position-@position.Id" @key="position.Id">
            <div class="d-flex flex-wrap align-items-baseline gap-2 border-bottom pb-2 mb-3">
                <h2 class="h4 mb-0" id="guide-position-@position.Id">@position.Name</h2>
                <span class="badge @(open <= 0 ? "text-bg-success" : "text-bg-light border")">
                    @section.Chosen.Count of @position.SeatsAvailable chosen
                </span>
            </div>

            <div class="row g-3">
                @foreach (var candidate in section.Chosen)
                {
                    <div class="col-md-6 guide-pick" @key="candidate.Id">
                        <div class="card shadow-sm border-success h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <CandidateAvatar Name="@candidate.Name" PhotoUrl="@candidate.PhotoUrl" Size="48" />
                                <div class="flex-grow-1 min-w-0">
                                    <h3 class="h5 card-title mb-1">
                                        <a class="text-body" href="@($"{Municipality.Slug}/candidates/{candidate.Id}")">@candidate.Name</a>
                                    </h3>
                                    <p class="card-subtitle small text-success mb-0">@candidate.PositionTitle</p>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm d-print-none"
                                        aria-label="@($"Remove {candidate.Name} from your voting guide")"
                                        @onclick="() => RemoveAsync(candidate)">
                                    Remove
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (open > 0 && section.HasMoreCandidates)
                {
                    <div class="col-md-6 d-print-none">
                        <div class="card h-100 guide-open-seat">
                            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                                <span class="flex-grow-1 text-secondary">
                                    @(section.Chosen.Count == 0 ? $"You can choose up to {position.SeatsAvailable}." : $"You can choose {open} more.")
                                </span>
                                <a class="btn btn-sm btn-outline-primary" href="@CandidatesHref(position.Id)">
                                    Browse @position.Name candidates
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else if (section.Chosen.Count == 0)
                {
                    <p class="text-secondary mb-0">No candidates have registered for this position yet.</p>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter, EditorRequired] public MunicipalityResponse Municipality { get; set; } = default!;

    private sealed record GuideView(IReadOnlyList<GuideSection> Sections)
    {
        public int ChosenCount => Sections.Sum(s => s.Chosen.Count);
    }

    // Public directory, loaded once per municipality; the view is rebuilt from it when the guide changes.
    private GuideData? data;
    private GuideView? view;
    private int droppedCount;
    private string? errorMessage;
    private string? statusMessage;
    private bool confirmingClear;
    private string? loadedSlug;
    private ElementReference statusElement;
    private CancellationTokenSource? cts;

    private string CandidatesHref(int? positionId = null) =>
        positionId is null ? $"{Municipality.Slug}/candidates" : $"{Municipality.Slug}/candidates?position={positionId}";

    protected override void OnInitialized() => Ballot.Changed += OnBallotChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (Municipality.Slug == loadedSlug) return;
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var slug = Municipality.Slug;
        loadedSlug = slug;
        view = null;
        errorMessage = null;
        statusMessage = null;
        confirmingClear = false;

        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        try
        {
            var loaded = await GuideLoader.LoadAsync(slug, token);
            if (token.IsCancellationRequested) return;

            data = loaded;
            droppedCount = loaded.DroppedCount;
            await RebuildAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Superseded by a newer load or the component was disposed.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load voting guide for {Slug}", slug);
            errorMessage = ex is ApiRequestException
                ? ex.Message
                : "We couldn't load your voting guide right now. Please try again.";
        }
    }

    private async Task RebuildAsync()
    {
        if (data is null) return;
        view = new GuideView(data.BuildSections(await Ballot.GetAsync(Municipality.Slug)));
    }

    private async void OnBallotChanged(string slug)
    {
        if (slug != Municipality.Slug) return;
        try
        {
            await RebuildAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh voting guide for {Slug}", slug);
        }
    }

    private async Task RemoveAsync(CandidateResponse candidate)
    {
        await Ballot.RemoveAsync(Municipality.Slug, candidate.Id);
        await AnnounceAsync($"Removed {candidate.Name} from your guide.");
    }

    private async Task ClearAsync()
    {
        confirmingClear = false;
        await Ballot.ClearAsync(Municipality.Slug);
        await AnnounceAsync("Your voting guide has been cleared.");
    }

    /// <summary>The clicked button disappears, so move focus to the status message, which also announces it.</summary>
    private async Task AnnounceAsync(string message)
    {
        statusMessage = message;
        StateHasChanged();
        await Task.Yield();
        await statusElement.FocusAsync();
    }

    private static string CountText(int count) => count == 1 ? "1 candidate" : $"{count} candidates";

    public void Dispose()
    {
        Ballot.Changed -= OnBallotChanged;
        cts?.Cancel();
        cts?.Dispose();
    }
}
