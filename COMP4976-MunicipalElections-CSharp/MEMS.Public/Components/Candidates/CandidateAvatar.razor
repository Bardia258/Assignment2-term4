@* Candidate photo, or their initials when no photo is available. Decorative: the name is always shown next to it. *@
@if (!string.IsNullOrWhiteSpace(PhotoUrl) && !photoFailed)
{
    <img class="candidate-avatar rounded-circle flex-shrink-0" src="@PhotoUrl" alt="" aria-hidden="true"
         style="@SizeStyle" loading="lazy" @onerror="() => photoFailed = true" />
}
else
{
    <span class="candidate-avatar candidate-avatar-initials rounded-circle flex-shrink-0" aria-hidden="true"
          style="@SizeStyle">@Initials</span>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? PhotoUrl { get; set; }

    /// <summary>Diameter in pixels.</summary>
    [Parameter] public int Size { get; set; } = 56;

    private bool photoFailed;
    private string? lastPhotoUrl;

    private string SizeStyle => $"width:{Size}px;height:{Size}px;font-size:{Size * 0.38:0}px";

    private string Initials
    {
        get
        {
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
            };
        }
    }

    protected override void OnParametersSet()
    {
        // Only retry the image when it actually changes, not on every parent re-render.
        if (PhotoUrl == lastPhotoUrl) return;
        lastPhotoUrl = PhotoUrl;
        photoFailed = false;
    }
}
