@page "/not-found"
@layout MainLayout
@using MEMS.Public.Services.Tenancy
@inject TenantState TenantState

<PageTitle>Page not found</PageTitle>

<div class="text-center py-5">
    <h1 class="h2">Page not found</h1>
    <p class="lead text-secondary">Sorry, the page you're looking for doesn't exist.</p>
    <a class="btn btn-primary" href="">Go to the home page</a>
</div>

@code {
    protected override void OnInitialized() => TenantState.Clear();
}
