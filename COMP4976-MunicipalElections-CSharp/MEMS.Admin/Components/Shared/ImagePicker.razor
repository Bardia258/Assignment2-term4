<div class="mb-3">
    <label for="@Id" class="form-label">@Label</label>
    @if (!string.IsNullOrEmpty(CurrentUrl))
    {
        <div class="mb-2"><img class="admin-preview" src="@CurrentUrl" alt="@($"Current {Label.ToLowerInvariant()}")" /></div>
    }
    <InputFile id="@Id" class="form-control" OnChange="Selected" accept="image/png,image/jpeg,image/webp" disabled="@Disabled" />
    <div class="form-text">Optional PNG, JPEG, or WebP. Maximum 2 MB and 16 megapixels, up to 8000 pixels per side. Leave blank to keep the existing image.</div>
    @if (_error is not null) { <div class="text-danger" role="alert">@_error</div> }
    @if (_name is not null) { <div class="form-text" role="status">Selected: @_name</div> }
</div>
@code {
    [Parameter] public string Id { get; set; } = "image";
    [Parameter] public string Label { get; set; } = "Photograph";
    [Parameter] public string? CurrentUrl { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<IBrowserFile?> OnSelected { get; set; }
    private string? _error;
    private string? _name;
    private async Task Selected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _error = null; _name = null;
        if (file.Size <= 0 || file.Size > AdminImageStore.MaxBytes)
        {
            _error = "Choose a nonempty image no larger than 2 MB.";
            await OnSelected.InvokeAsync(file); return;
        }
        _name = file.Name;
        await OnSelected.InvokeAsync(file);
    }
}
