<nav aria-label="Administration">
    <a class="admin-brand" href="/admin">MEMS <span>Administration</span></a>
    <details class="admin-menu" open>
        <summary>Navigation</summary>
        <AuthorizeView Policy="@AdminPolicies.Administrator">
            <Authorized>
                <div class="admin-links">
                    <NavLink href="/admin" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink href="/admin/municipalities">Municipalities</NavLink>
                    <NavLink href="/admin/positions">Positions</NavLink>
                    <NavLink href="/admin/candidates">Candidates</NavLink>
                </div>
                <div class="admin-account">
                    <p class="small text-break">Signed in as<br /><strong>@context.User.Identity?.Name</strong></p>
                    <form method="post" action="/admin/account/sign-out" data-enhance="false">
                        <AntiforgeryToken /><button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized><a class="admin-signin" href="/admin/login">Administrator sign in</a></NotAuthorized>
        </AuthorizeView>
    </details>
</nav>
