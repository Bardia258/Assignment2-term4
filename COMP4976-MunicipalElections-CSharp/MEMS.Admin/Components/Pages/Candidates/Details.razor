@page "/admin/candidates/{Id:int}"
@page "/admin/candidates/{Id:int}/delete"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]
@inherits AdminPageBase
<PageTitle>@(DeleteMode ? "Delete candidate" : "Candidate details") · MEMS Admin</PageTitle>
<h1>@(DeleteMode ? "Delete candidate" : "Candidate details")</h1>
<PageStatus Busy="Busy" Error="@Error" Saved="Saved" />
@if (_item is not null)
{
    @if (_item.PhotoUrl is not null) { <img class="admin-preview mb-3" src="@_item.PhotoUrl" alt="@($"Photograph of {_item.Name}")" /> }
    <dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@_item.Name</dd><dt class="col-sm-3">Municipality</dt><dd class="col-sm-9">@_item.MunicipalityName</dd><dt class="col-sm-3">Position</dt><dd class="col-sm-9">@_item.PositionTitle</dd><dt class="col-sm-3">Biography</dt><dd class="col-sm-9 biography">@_item.Profile</dd><dt class="col-sm-3">Website</dt><dd class="col-sm-9 text-break"><ExternalLink Value="@_item.Website" /></dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9 text-break">@(_item.Email ?? "Not provided")</dd><dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@_item.DateCreated.ToString("yyyy-MM-dd HH:mm")</dd></dl>
    @if (DeleteMode) {
        <div class="alert alert-warning">Deletion is permanent and also removes dependent saved-candidate links. This cannot be undone.</div>
        <div class="form-check mb-3"><input id="confirm-delete" class="form-check-input" type="checkbox" @bind="_confirmed" /><label class="form-check-label" for="confirm-delete">I confirm deletion of @_item.Name.</label></div>
        <button class="btn btn-danger" type="button" disabled="@(Busy || !_confirmed)" @onclick="Delete">Delete candidate</button>
    } else {
        <a class="btn btn-primary" href="@($"/admin/candidates/{Id}/edit")">Edit candidate</a><a class="btn btn-outline-danger" href="@($"/admin/candidates/{Id}/delete")">Delete</a>
    }
    <a class="btn btn-outline-secondary" href="/admin/candidates">@(DeleteMode ? "Cancel" : "Back to candidates")</a>
}
@code {
    [Parameter] public int Id { get; set; }
    private CandidateResponse? _item;
    private bool _confirmed;
    private bool DeleteMode => new Uri(Navigation.Uri).AbsolutePath.EndsWith("/delete", StringComparison.OrdinalIgnoreCase);
    protected override Task OnParametersSetAsync() => Run(async () => { _item = null; _confirmed = false; _item = await Data.CandidateAsync(Id); });
    private Task Delete() => Run(async () =>
    {
        if (!_confirmed) return;
        await Data.DeleteCandidateAsync(Id, _item!.Revision);
        Navigation.NavigateTo("/admin/candidates?deleted=true");
    });
}
